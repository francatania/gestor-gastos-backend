{
  "compilerOptions": {

    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",      
    "target": "ES2020",
    "moduleResolution": "node",


    "allowJs": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "strict": true,


    "sourceMap": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*"]
}
